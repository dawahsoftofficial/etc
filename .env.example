# Copy to .env and fill in. Never commit .env.
# Cluster scripts (scripts/create-databases.mjs, npm run mockup:upload) read DB_* and SPACES_* from .env.cluster.local instead.
DATABASE_URL=
SHADOW_DATABASE_URL=
AUTH_SECRET=
AUTH_TRUST_HOST=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_BASE=
IP_HASH_SALT=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Private preview: every page needs one of these logins (HTTP Basic Auth). Leave empty to make the site public.
# Format: name:password,name2:password2 — no commas in passwords. Use long random passwords.
SITE_ACCESS=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_ENV=development
